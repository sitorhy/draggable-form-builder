pipeline {
    agent any

    stages {
        stage('拉取代码') {
            steps {
                git branch: 'front-end-v2', url: 'https://github.com/sitorhy/draggable-form-builder.git'
            }
        }

        stage('编译') {
            steps {
                dir('back-end/project-publisher') {
                    sh "mvn -v"
                    sh "mvn clean package"
                }
            }
        }

        stage('构建镜像') {
            steps {
                dir('back-end/project-publisher') {
                    // docker build -t <镜像名称>:<标签> <ContextPath>
                    // 忽略版本管理
                    // sh "docker build -t project-publisher-server:lastest ."

                    sh "docker-compose --version"
                    sh "docker-compose down"
                    sh "docker-compose up -d"
                }
            }
        }
    }
}
