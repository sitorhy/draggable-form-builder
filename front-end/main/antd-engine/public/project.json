  "functions": [
    {
      "id": "f8c24a17-7929-4620-b11d-cda8815ffaa7",
      "name": "formSubmit",
      "code": "export default async function submit() {\n\tconst formRef = this.findComponentRef('form887', 'form');\n\tif (formRef && typeof formRef.validate === 'function') {\n\t\ttry {\n\t\t\tconst valid = await formRef.validate();\n\t\t\tif (valid) {\n\t\t\t\tthis.tools.message.success('校验通过');\n\t\t\t}\n\t\t} catch (e) {\n\t\t\tconsole.log(e.message);\n\t\t\t// ignore\n\t\t}\n\t}\n}",
      "description": "【表单】验证按钮点击"
    },
    {
      "id": "425fc337-31bd-40fd-b660-ef3483ad6d12",
      "name": "validateAge",
      "code": "export default function validateAge(rule, value) {\n\tif (!value) {\n\t\treturn new Error('需要年龄')\n\t}\n\telse if (!/^\\d*$/.test(value)) {\n\t\treturn new Error('年龄应该为整数')\n\t}\n\telse if (Number(value) < 18) {\n\t\treturn new Error('年龄应该超过十八岁')\n\t}\n\treturn true\n}",
      "description": "【表单】年龄校验"
    },
    {
      "id": "6e614211-15b2-4c2d-9e2d-ffd1f47ba474",
      "name": "validatePasswordStartWith",
      "code": "export default function validatePasswordStartWith(rule, value) {\n\ttry {\n\t\tconst appContext = this.getApplicationContext();\n\t\tconst bindingStore = appContext.bindingStore;\n\n\t\tconst formValue = bindingStore.state.page859.form887;\n\n\t\tconsole.log(formValue);\n\n\t\treturn (\n\t\t\t!!formValue.password\n\t\t\t&& formValue.password.startsWith(value)\n\t\t\t&& formValue.password.length >= value.length\n\t\t);\n\t} catch (error) {\n\t\treturn error;\n\t}\n}\n",
      "description": "【表单】重复密码校验"
    },
    {
      "id": "603fd2b0-49fe-4b7a-b6cd-4b7269f4fd4f",
      "name": "validatePasswordSame",
      "code": "function validatePasswordSame(rule, value) {\n\ttry {\n\t\tconst appContext = this.getApplicationContext();\n\t\tconst bindingStore = appContext.bindingStore;\n\n\t\tconst formValue = bindingStore.state.page859.form887;\n\t\treturn value === formValue.password;\n\t} catch (error) {\n\t\treturn error;\n\t}\n}",
      "description": "【表单】两次密码是否相同"
    },
    {
      "id": "f636df44-11f3-42fb-ac7a-8b8d85d5ddb5",
      "name": "consoleLog",
      "code": "export default function log(value) {\n    console.log(value);\n    return value;\n}",
      "description": "通用，控制台打印，打印并返回过滤值"
    },
    {
      "id": "b60b0e2c-1e8b-4cc1-b0f9-409e19f05556",
      "name": "toSafeString",
      "code": "export default function(value) {\n    if (typeof value !== 'string') {\n        return '';\n    }\n    return value;\n}",
      "description": "通用，过滤非字符串对象为空字符串"
    },
    {
      "id": "163a8cad-75e7-4b23-a383-b9039fc92219",
      "name": "toString",
      "code": "export default function(value) {\n    return String(value);\n}",
      "description": "通用，强制转换为字符串"
    },
